{
    "name": "jeytekdev/explain-lint",
    "description": "Re-runs EXPLAIN against every SQL query captured during your test suite and fails the build on full table scans, lost indexes, filesort and temporary tables.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sql",
        "explain",
        "mysql",
        "postgresql",
        "phpunit",
        "testing",
        "query-analysis",
        "index",
        "performance"
    ],
    "homepage": "https://github.com/jeytekdev/explain-lint-core",
    "support": {
        "issues": "https://github.com/jeytekdev/explain-lint-core/issues",
        "source": "https://github.com/jeytekdev/explain-lint-core"
    },
    "authors": [
        {
            "name": "Jeytekdev",
            "homepage": "https://github.com/jeytekdev"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "symfony/console": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "phpunit/phpunit": "Required to use the Jeytekdev\\ExplainLint\\PHPUnit\\ExplainLintExtension PHPUnit/Pest integration (^10.5 || ^11.0)."
    },
    "autoload": {
        "psr-4": {
            "Jeytekdev\\ExplainLint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeytekdev\\ExplainLint\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/explain-lint"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    }
}
